# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_or_channel_username_here

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///database.db

# Scraping & Verification Settings
SCRAPE_INTERVAL_MINUTES=10
MIN_DISCOUNT_PERCENTAGE=15
GOOGLE_SEARCH_DOMAINS=amazon.com.tr,hepsiburada.com,trendyol.com,n11.com,teknosa.com,vatanbilgisayar.com
